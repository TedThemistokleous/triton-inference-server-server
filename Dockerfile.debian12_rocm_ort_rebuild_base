#
# Debian 12 + ROCm 7.0 + Python 3.10 Base Image
# This base image is used by all Triton build stages for onnxruntime backend with ROCm enabled on Debian OS to avoid redundant installations
#

FROM debian:12

# Prevent apt-get from prompting for input
ENV DEBIAN_FRONTEND=noninteractive

# Allow pip to install packages system-wide (needed for Debian 12+)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Install basic dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        gnupg2 \
        curl \
        software-properties-common \
        build-essential \
        git \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Install Python 3.10 from source on Debian 12
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl-dev zlib1g-dev libbz2-dev \
        libreadline-dev libsqlite3-dev \
        libncursesw5-dev xz-utils tk-dev \
        libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev && \
    wget https://www.python.org/ftp/python/3.10.16/Python-3.10.16.tgz && \
    tar xzf Python-3.10.16.tgz && \
    cd Python-3.10.16 && \
    ./configure --enable-optimizations && \
    make -j$(nproc) && \
    make altinstall && \
    cd .. && rm -rf Python-3.10.16 Python-3.10.16.tgz && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/local/bin/python3.10 2 && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    python3.10 --version && \
    python3.10 -m pip install --upgrade pip setuptools==69.5.1 wheel && \
    rm -rf /var/lib/apt/lists/*

# Install ROCm 7.0.1 (runtime + development packages) on Debian 12
RUN wget https://repo.radeon.com/amdgpu-install/7.0.1/ubuntu/jammy/amdgpu-install_7.0.1.70001-1_all.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends ./amdgpu-install_7.0.1.70001-1_all.deb && \
    rm amdgpu-install_7.0.1.70001-1_all.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        rocm-dev \
        rocm-libs \
        hip-base \
        hip-dev \
        rocm-device-libs \
        rocblas \
        rocblas-dev \
        hipblas \
        hipblas-dev \
        miopen-hip \
        miopen-hip-dev \
        rocrand \
        rocrand-dev \
        rccl \
        rccl-dev && \
    rm -rf /var/lib/apt/lists/*

# Install libevent (needed by Triton for HTTP/gRPC endpoints)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libevent-2.1-7 \
        libevent-core-2.1-7 \
        libevent-pthreads-2.1-7 \
        libevent-dev && \
    rm -rf /var/lib/apt/lists/*

# Install common runtime dependencies used by Triton
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libb64-0d \
        libcurl4-openssl-dev \
        libre2-9 \
        libre2-dev \
        libnuma-dev \
        libnuma1 \
        libgoogle-perftools-dev \
        libjemalloc-dev && \
    rm -rf /var/lib/apt/lists/*


# Install cmake
RUN apt update -q=2 && apt install -y wget && \
    wget -q https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-x86_64.tar.gz && \
    tar -zxf cmake-3.28.3-linux-x86_64.tar.gz -C /opt && \
    rm cmake-3.28.3-linux-x86_64.tar.gz && \
    ln -sf /opt/cmake-3.28.3-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake-3.28.3-linux-x86_64/bin/ctest /usr/local/bin/ctest && \
    ln -sf /opt/cmake-3.28.3-linux-x86_64/bin/cpack /usr/local/bin/cpack && \
    cmake --version 

# Set ROCm environment variables
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:${LD_LIBRARY_PATH}

# build MIGraphX from source
# FIXME: make changes to this path
WORKDIR /home/AMD/linsun12/triton_inference_server/internal/rocm7.0
RUN git clone https://github.com/ROCm/AMDMIGraphX.git --recursive -b develop && \
    cd AMDMIGraphX && \
    pip3 install --prefix /usr/local https://github.com/RadeonOpenCompute/rbuild/archive/master.tar.gz && \
    rbuild build -d depend -B build -DMIGRAPHX_ENABLE_PYTHON=OFF -DGPU_TARGETS=$(/opt/rocm/bin/rocminfo | grep -o -m1 'gfx.*') 2>&1 | tee migraphx_build.log && \
    cd build && \
    cmake --install . --prefix /opt/rocm && \
    make install

# build onnxruntime with MIGraphX EP from source
# FIXME: make changes to this path
WORKDIR /home/AMD/linsun12/triton_inference_server/internal/rocm7.0
RUN git clone https://github.com/ROCm/onnxruntime.git --recursive -b rocm7.0_internal_testing && \
    cd onnxruntime && \
    sed -i '/"If",/d' onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc && \
    echo "Removed 'If' operator from mgx_supported_ops" && \
    pip install numpy packaging && \
    ./build.sh --allow_running_as_root --rocm_home /opt/rocm --use_migraphx --migraphx_home /opt/rocm --skip_tests --parallel --cmake_extra_defines CMAKE_HIP_ARCHITECTURES=gfx942 --enable_pybind --build_wheel --config Release && \
    pip install ./build/Linux/Release/dist/*.whl --force-reinstall

WORKDIR /workspace

